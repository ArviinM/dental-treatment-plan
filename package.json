{
  "name": "dental-treatment-plan",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "db:link": "./scripts/with-env.sh sh -c 'npx supabase link --project-ref \"$SUPABASE_PROJECT_REF\"'",
    "db:push": "./scripts/with-env.sh npx supabase db push",
    "db:diff": "./scripts/with-env.sh npx supabase db diff --linked",
    "db:lint": "./scripts/with-env.sh npx supabase db lint --linked",
    "db:types": "./scripts/with-env.sh sh -c 'npx supabase gen types typescript --linked > src/lib/database.types.ts'",
    "db:whoami": "./scripts/with-env.sh npx supabase projects list",
    "db:seed": "./scripts/with-env.sh npx supabase db query --linked --file supabase/seed.sql",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "next": "16.3.5",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.449",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.67.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
