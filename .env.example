# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.
# Every value below comes from the Supabase dashboard:
#   Project Settings → API

# Safe to expose. These are sent to the browser, and row level security is what
# actually protects the data behind them.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses row level security completely — it can read and write every
# patient record in the database. Server-side only, never in a NEXT_PUBLIC_ var,
# never committed, never pasted into a chat or an issue. In the app it is read
# by exactly one module, src/lib/supabase/admin.ts, which is marked server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Used by `yarn db:link`. The ref is the subdomain of the project URL above.
SUPABASE_PROJECT_REF=

# A personal access token for the Supabase CLI, from
#   https://supabase.com/dashboard/account/tokens
# Only needed because `supabase login`'s browser flow cannot run in a non-TTY
# shell. Putting it here instead of passing --token keeps it out of shell
# history. The db:* scripts load this file via scripts/with-env.sh.
SUPABASE_ACCESS_TOKEN=

# Optional. Sets absolute URLs for social preview images; Vercel fills this in
# per deployment on its own, so it is only needed for local testing.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
